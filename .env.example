# ===== LLM provider =====
# Options: gemini | anthropic | openai | ollama
LLM_PROVIDER=gemini

# ----- Gemini (FREE tier recommended for demo) -----
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-2.0-flash

# ----- Anthropic (paid) -----
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ----- OpenAI (paid) -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----- Ollama (local, free, no key) -----
# Start with: docker compose --profile local up -d ollama
# Then pull a model: docker exec knowit-ollama ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=ollama/llama3.1:8b

# ===== App config =====
APP_PORT=8080

# Path to Solution EI repo (mounted read-only into /mnt/repo).
# Relative to this docker-compose.yml.
REPO_PATH=../../sds-solution-ei

# Session inactivity TTL (minutes)
SESSION_TTL_MIN=30

# Full-fidelity history turns. Older turns are summarised.
MAX_HISTORY_TURNS=10

# Retrieval: how many chunks per query
RETRIEVAL_TOP_K=6

# Balanced retrieval: floor per source kind (handbook + repo).
# With RETRIEVAL_PER_KIND=3 and RETRIEVAL_TOP_K=6, you always get up to 3
# handbook chunks + 3 repo chunks (if each pool has matches), preventing
# one corpus from crowding out the other.
RETRIEVAL_PER_KIND=3

# Per-kind retrieval score multipliers. Higher = that kind surfaces first
# on close-score ties. Defaults (if left blank):
#   userguide / guide / tutorial  → 1.5   (user perspective surfaces first)
#   repo (source code)            → 1.3   (implementation truth next)
#   handbook / developer          → 1.15  (canonical field & schema definitions)
#   spark / error reference       → 1.05  (specialised fallback)
# Override per kind via comma-separated pairs, e.g.
#   RETRIEVAL_KIND_WEIGHTS=kguserguide:1.6,repo:1.3,handbook:1.1,spark:1.05
RETRIEVAL_KIND_WEIGHTS=

# Legacy single-knob boost for any non-handbook kind. Kept for backward
# compatibility; RETRIEVAL_KIND_WEIGHTS overrides it when set.
RETRIEVAL_CODE_BOOST=1.35

# Cap on pasted log length (chars) to avoid huge prompts
MAX_LOG_CHARS=20000

# Maximum chunks indexed from the repo. The Solution EI repo has ~1400 files —
# indexing everything makes first-boot embedding take 5+ minutes on CPU. 2000
# is a safe upper bound. Raise if your teammates need deeper coverage AND have
# accepted the slower startup.
MAX_REPO_CHUNKS=2000

# Batch size for embedding. 32 is memory-friendly on CPU; raise to 64+ if you
# have plenty of RAM.
EMBED_BATCH_SIZE=32

# ===== Response cache =====
# Stores final answers so repeat questions skip the LLM entirely. Cache is
# keyed on (index content hash + system prompt + session history + user
# message), so re-indexing the handbook or editing system.md auto-invalidates.
# Persisted to the same volume as the embedding cache.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_HOURS=24
# Upper bound on cache entries (LRU evicted when exceeded). 0 = unbounded.
RESPONSE_CACHE_MAX_ENTRIES=500

# ===== Agent / MCP =====
# Port exposed for the MCP server (Cursor / Claude Desktop / other MCP clients
# connect here via http://host:<MCP_PORT>/sse).
MCP_PORT=8765

# Bearer token required to call /api/agent/* and the MCP server. Leave blank
# for local / internal-network use. Set a long random string before exposing
# the MCP port outside your machine or cluster.
AGENT_API_TOKEN=
